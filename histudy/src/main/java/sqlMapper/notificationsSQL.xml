<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.histudy.notifications">
	<insert id="sendNotice" parameterType="com.histudy.notifications.model.NotificationsDTO">
		INSERT INTO notifications VALUES(n_idx.nextval, #{n_sender_idx}, #{n_type}, #{n_title}, #{n_content}, #{n_read}, sysdate, #{user_idx})
	</insert>
	<select id="selectNotice" parameterType="int" resultType="com.histudy.notifications.model.NotificationsDTO">
		select *
		from notifications
		where user_idx=#{user_idx}
		order by n_idx desc
	</select>
	<update id="updateNotice" parameterType="int">
		update notifications 
		set n_read='읽음' 
		where n_read='안읽음'
			and user_idx=#{user_idx}
	</update>
	<delete id="deleteNotice" parameterType="int">
		delete from notifications 
		where n_idx=#{n_idx}
	</delete>
	
</mapper>